class Queue:
    def __init__(self):
        self.queue = []

    def enqueue(self, item):
        self.queue.append(item)
        print(item, "added")

    def dequeue(self):
        if not self.is_empty():
            print(self.queue.pop(0), "removed")
        else:
            print("Queue is empty")

    def front(self):
        if not self.is_empty():
            print("Front element:", self.queue[0])
        else:
            print("Queue is empty")

    def is_empty(self):
        return len(self.queue) == 0


# Example
q = Queue()

q.enqueue(10)
q.enqueue(20)
q.enqueue(30)

q.front()  #for first element we can see 
q.dequeue()
q.dequeue()
q.dequeue()
q.dequeue()
